<div class="details-section flexrow">
    <div class="document-details">
        <ul>
            {{#each detailFields as |field|}}
            {{#unless field.full}}
            <li {{#if field.hidden}} style="display:none;" {{/if}}>
                <label>{{localize field.name}}{{#if field.playerHidden}} <i class="fas fa-eye-slash" data-tooltip="{{localize 'MonksEnhancedJournal.HiddenFromPlayers'}}"></i>{{/if}}</label>
                {{#if field.enriched}}
                <div class="mej-field-display" data-field="{{field.id}}">{{{field.enriched}}}</div>
                <input type="text" class="mej-field-edit" style="display:none" name="flags.monks-enhanced-journal.attributes.{{field.id}}" value="{{ field.value }}" />
                {{else}}
                <input type="text" name="flags.monks-enhanced-journal.attributes.{{field.id}}" value="{{ field.value }}" />
                {{/if}}
            </li>
            {{/unless}}
            {{/each}}
        </ul>
    </div>
</div>
<div class="details-section scrollable flexcol">
    {{#each detailFields as |field|}}
    {{#if field.full}}
    <div class="form-group" {{#if field.hidden}} style="display:none;" {{/if}}>
        <label>{{localize field.name}}{{#if field.playerHidden}} <i class="fas fa-eye-slash" data-tooltip="{{localize 'MonksEnhancedJournal.HiddenFromPlayers'}}"></i>{{/if}}</label>
        {{#if field.enriched}}
        <div class="mej-field-display" data-field="{{field.id}}">{{{field.enriched}}}</div>
        <textarea class="mej-field-edit" style="display:none" name="flags.monks-enhanced-journal.attributes.{{field.id}}">{{field.value}}</textarea>
        {{else}}
        <textarea name="flags.monks-enhanced-journal.attributes.{{field.id}}">{{field.value}}</textarea>
        {{/if}}
    </div>
    {{/if}}
    {{/each}}
</div>
